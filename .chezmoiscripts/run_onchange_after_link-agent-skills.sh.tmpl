{{ if and (eq .chezmoi.os "linux") (ne .profile "server") -}}
#!/usr/bin/env bash
set -euo pipefail

# agy-crew {{ .packages.agy_crew }}
# worktrunk {{ .packages.worktrunk }}
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

pkg_installer=""
if command -v bun >/dev/null 2>&1; then
    case "$(command -v bun)" in
        /mnt/*) ;;
        *) pkg_installer="bun" ;;
    esac
fi
if [ -z "${pkg_installer}" ] && command -v npm >/dev/null 2>&1; then
    case "$(command -v npm)" in
        /mnt/*) ;;
        *) pkg_installer="npm" ;;
    esac
fi

if [ -n "${pkg_installer}" ] && command -v agy >/dev/null 2>&1; then
    if ! "${pkg_installer}" install -g "agy-crew@{{ .packages.agy_crew }}"; then
        echo "Warning: could not install agy-crew; skipping omp skill linking." >&2
    else
        if [ -x "${HOME}/.local/bin/mise" ]; then
            "${HOME}/.local/bin/mise" reshim || true
        fi

        if command -v agy-crew >/dev/null 2>&1; then
            agy-crew install --hosts omp || true
        elif [ -x "${HOME}/.local/bin/mise" ]; then
            "${HOME}/.local/bin/mise" exec -- agy-crew install --hosts omp || true
        fi
    fi
else
    echo "Skipping agy-crew skill linking: bun/npm or agy is not on PATH."
fi

# Worktrunk plugins for omp and Claude Code
wt_bin=""
if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
    wt_bin="${HOME}/.local/share/mise/shims/wt"
elif command -v wt >/dev/null 2>&1; then
    candidate="$(command -v wt)"
    case "${candidate}" in
        /mnt/*) ;;
        *) wt_bin="${candidate}" ;;
    esac
fi

if [ -n "${wt_bin}" ]; then
    echo "Installing Worktrunk plugins..."
    "${wt_bin}" config plugins omp install --yes || true
    if command -v claude >/dev/null 2>&1; then
        case "$(command -v claude)" in
            /mnt/*) ;;
            *) "${wt_bin}" config plugins claude install --yes || true ;;
        esac
    fi
fi
{{ end -}}
