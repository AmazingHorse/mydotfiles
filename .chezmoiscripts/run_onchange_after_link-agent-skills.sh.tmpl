{{ if and (eq .chezmoi.os "linux") (ne .profile "server") -}}
#!/usr/bin/env bash
set -euo pipefail

# worktrunk {{ .packages.worktrunk }}
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

# Worktrunk plugins for omp and Claude Code
wt_bin=""
if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
    wt_bin="${HOME}/.local/share/mise/shims/wt"
elif command -v wt >/dev/null 2>&1; then
    candidate="$(command -v wt)"
    case "${candidate}" in
        /mnt/*) ;;
        *) wt_bin="${candidate}" ;;
    esac
fi

if [ -n "${wt_bin}" ]; then
    echo "Scanning and installing Worktrunk plugins..."
    for target in omp claude codex opencode pi; do
        if [ "$target" = "omp" ]; then
            "${wt_bin}" config plugins omp install --yes || true
        elif command -v "$target" >/dev/null 2>&1; then
            target_bin="$(command -v "$target")"
            case "${target_bin}" in
                /mnt/*|[A-Za-z]:/*) ;;
                *) "${wt_bin}" config plugins "$target" install --yes || true ;;
            esac
        fi
    done
fi
{{ end -}}
