{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

preferred_oh_my_posh_version='{{ .packages.oh_my_posh }}'
preferred_git_version='{{ .packages.git }}'
minimum_git_version='{{ .packages.git_minimum }}'

if ! command -v apt-get >/dev/null 2>&1; then
    echo "Skipping package install: apt-get not found." >&2
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive

version_ge() {
    local left_version="$1"
    local right_version="$2"
    local lowest_version
    lowest_version="$(printf '%s\n%s\n' "${left_version}" "${right_version}" | sort -V | head -n1)"
    [ "${lowest_version}" = "${right_version}" ]
}

get_git_installed_semver() {
    if ! command -v git >/dev/null 2>&1; then
        return 0
    fi

    local version_output
    version_output="$(git version 2>/dev/null || true)"
    if [[ "${version_output}" =~ git\ version\ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}

ensure_git_core_ppa() {
    if apt-cache policy git 2>/dev/null | grep -q 'ppa.launchpadcontent.net/git-core/ppa\|ppa.launchpad.net/git-core/ppa'; then
        return 0
    fi

    if ! command -v add-apt-repository >/dev/null 2>&1; then
        sudo apt-get install -y software-properties-common
    fi

    echo "Adding git-core PPA (preferred Git ${preferred_git_version}, minimum ${minimum_git_version})"
    sudo add-apt-repository -y ppa:git-core/ppa
}

ensure_modern_git() {
    local installed_semver
    installed_semver="$(get_git_installed_semver)"
    if [ -n "${installed_semver}" ] &&
        version_ge "${installed_semver}" "${minimum_git_version}" &&
        [ "${installed_semver}" = "${preferred_git_version}" ]; then
        echo "Git already at preferred version ${preferred_git_version}"
        return 0
    fi

    if [ -n "${installed_semver}" ] &&
        version_ge "${installed_semver}" "${minimum_git_version}" &&
        ! apt-cache policy git 2>/dev/null | grep -q 'ppa.launchpadcontent.net/git-core/ppa\|ppa.launchpad.net/git-core/ppa'; then
        echo "Git ${installed_semver} already satisfies minimum ${minimum_git_version}; upgrading via git-core PPA when available."
    fi

    ensure_git_core_ppa
    sudo apt-get update
    sudo apt-get install -y git

    installed_semver="$(get_git_installed_semver)"
    if [ -z "${installed_semver}" ] || ! version_ge "${installed_semver}" "${minimum_git_version}"; then
        echo "Git install finished, but version is '${installed_semver:-unknown}' (minimum ${minimum_git_version} required for zdiff3)." >&2
        exit 1
    fi

    if [ "${installed_semver}" = "${preferred_git_version}" ]; then
        echo "Git installed at preferred version ${preferred_git_version}"
    else
        echo "Git installed at ${installed_semver} (preferred ${preferred_git_version} is not published for this Ubuntu release; minimum ${minimum_git_version} satisfied)."
    fi
}

ensure_pinned_oh_my_posh() {
    local install_directory="${HOME}/.local/bin"
    mkdir -p "${install_directory}"

    local architecture
    architecture="$(uname -m)"
    local oh_my_posh_asset
    case "${architecture}" in
        x86_64|amd64)
            oh_my_posh_asset='posh-linux-amd64'
            ;;
        aarch64|arm64)
            oh_my_posh_asset='posh-linux-arm64'
            ;;
        *)
            echo "Unsupported architecture for pinned Oh My Posh: ${architecture}" >&2
            exit 1
            ;;
    esac

    local installed_oh_my_posh_version=''
    if command -v oh-my-posh >/dev/null 2>&1; then
        installed_oh_my_posh_version="$(oh-my-posh version 2>/dev/null || true)"
    fi

    if [ "${installed_oh_my_posh_version}" = "${preferred_oh_my_posh_version}" ]; then
        echo "Oh My Posh already at pinned version ${preferred_oh_my_posh_version}"
        return 0
    fi

    local download_url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/v${preferred_oh_my_posh_version}/${oh_my_posh_asset}"
    local target_path="${install_directory}/oh-my-posh"
    local temporary_path
    temporary_path="$(mktemp)"

    echo "Installing pinned Oh My Posh ${preferred_oh_my_posh_version} from ${download_url}"
    curl -fsSL "${download_url}" -o "${temporary_path}"
    chmod 755 "${temporary_path}"
    mv "${temporary_path}" "${target_path}"

    installed_oh_my_posh_version="$("${target_path}" version 2>/dev/null || true)"
    if [ "${installed_oh_my_posh_version}" != "${preferred_oh_my_posh_version}" ]; then
        echo "Oh My Posh install finished, but version is '${installed_oh_my_posh_version}' (expected '${preferred_oh_my_posh_version}')" >&2
        exit 1
    fi
}

sudo apt-get update
sudo apt-get install -y \
    curl \
    fzf \
    software-properties-common \
    zsh \
    zsh-autosuggestions \
    zsh-syntax-highlighting

ensure_modern_git
ensure_pinned_oh_my_posh
{{ end -}}
