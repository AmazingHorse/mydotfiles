{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

preferred_oh_my_posh_version='{{ .packages.oh_my_posh }}'
preferred_git_version='{{ .packages.git }}'
minimum_git_version='{{ .packages.git_minimum }}'
preferred_mise_version='{{ .packages.mise }}'
preferred_just_version='{{ .packages.just }}'
preferred_zoxide_version='{{ .packages.zoxide }}'
preferred_ripgrep_version='{{ .packages.ripgrep }}'
preferred_fd_version='{{ .packages.fd }}'
preferred_git_delta_version='{{ .packages.git_delta }}'
preferred_nerd_fonts_version='{{ .packages.nerd_fonts }}'
# mise global config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
{{ $isWsl := eq (includeTemplate "is-wsl" . | trim) "true" -}}

if ! command -v apt-get >/dev/null 2>&1; then
    echo "Skipping package install: apt-get not found." >&2
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
install_directory="${HOME}/.local/bin"
cache_directory="${HOME}/.cache/mydotfiles/downloads"
mkdir -p "${install_directory}" "${cache_directory}"
export PATH="${install_directory}:${PATH}"

version_ge() {
    local left_version="$1"
    local right_version="$2"
    local lowest_version
    lowest_version="$(printf '%s\n%s\n' "${left_version}" "${right_version}" | sort -V | head -n1)"
    [ "${lowest_version}" = "${right_version}" ]
}

get_git_installed_semver() {
    if ! command -v git >/dev/null 2>&1; then
        return 0
    fi

    local version_output
    version_output="$(git version 2>/dev/null || true)"
    if [[ "${version_output}" =~ git\ version\ ([0-9]+\.[0-9]+\.[0-9]+) ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
    fi
}

ensure_git_core_ppa() {
    if apt-cache policy git 2>/dev/null | grep -q 'ppa.launchpadcontent.net/git-core/ppa\|ppa.launchpad.net/git-core/ppa'; then
        return 0
    fi

    if ! command -v add-apt-repository >/dev/null 2>&1; then
        sudo apt-get install -y software-properties-common
    fi

    echo "Adding git-core PPA (preferred Git ${preferred_git_version}, minimum ${minimum_git_version})"
    sudo add-apt-repository -y ppa:git-core/ppa
}

ensure_modern_git() {
    local installed_semver
    installed_semver="$(get_git_installed_semver)"
    if [ -n "${installed_semver}" ] &&
        version_ge "${installed_semver}" "${minimum_git_version}" &&
        [ "${installed_semver}" = "${preferred_git_version}" ]; then
        echo "Git already at preferred version ${preferred_git_version}"
        return 0
    fi

    if [ -n "${installed_semver}" ] &&
        version_ge "${installed_semver}" "${minimum_git_version}" &&
        ! apt-cache policy git 2>/dev/null | grep -q 'ppa.launchpadcontent.net/git-core/ppa\|ppa.launchpad.net/git-core/ppa'; then
        echo "Git ${installed_semver} already satisfies minimum ${minimum_git_version}; upgrading via git-core PPA when available."
    fi

    ensure_git_core_ppa
    sudo apt-get update
    sudo apt-get install -y git

    installed_semver="$(get_git_installed_semver)"
    if [ -z "${installed_semver}" ] || ! version_ge "${installed_semver}" "${minimum_git_version}"; then
        echo "Git install finished, but version is '${installed_semver:-unknown}' (minimum ${minimum_git_version} required for zdiff3)." >&2
        exit 1
    fi

    if [ "${installed_semver}" = "${preferred_git_version}" ]; then
        echo "Git installed at preferred version ${preferred_git_version}"
    else
        echo "Git installed at ${installed_semver} (preferred ${preferred_git_version} is not published for this Ubuntu release; minimum ${minimum_git_version} satisfied)."
    fi
}

download_with_retries() {
    local destination_path="$1"
    local source_url="$2"
    local attempt=1
    local partial_path="${destination_path}.partial"

    while [ "${attempt}" -le 5 ]; do
        echo "Downloading ${source_url} (attempt ${attempt}/5)..."
        if curl \
            --fail \
            --location \
            --connect-timeout 20 \
            --max-time 300 \
            --output "${partial_path}" \
            "${source_url}"; then
            mv "${partial_path}" "${destination_path}"
            return 0
        fi
        rm -f "${partial_path}"
        attempt=$((attempt + 1))
        sleep 2
    done

    echo "Failed to download ${source_url} after 5 attempts." >&2
    return 1
}

linux_musl_target_triple() {
    local architecture
    architecture="$(uname -m)"
    case "${architecture}" in
        x86_64|amd64)
            printf 'x86_64-unknown-linux-musl\n'
            ;;
        aarch64|arm64)
            printf 'aarch64-unknown-linux-musl\n'
            ;;
        *)
            echo "Unsupported architecture: ${architecture}" >&2
            return 1
            ;;
    esac
}

delta_linux_target_triple() {
    local architecture
    architecture="$(uname -m)"
    case "${architecture}" in
        x86_64|amd64)
            # musl build avoids GLIBC_2.32+ requirements on Ubuntu 20.04.
            printf 'x86_64-unknown-linux-musl\n'
            ;;
        aarch64|arm64)
            # Upstream ships gnu-only for arm64.
            printf 'aarch64-unknown-linux-gnu\n'
            ;;
        *)
            echo "Unsupported architecture: ${architecture}" >&2
            return 1
            ;;
    esac
}

install_pinned_tarball_binary() {
    local tool_name="$1"
    local pinned_version="$2"
    local archive_url="$3"
    local binary_name="$4"
    local version_pattern="$5"

    # Path-first pin check: do not rely on PATH / command -v for ~/.local/bin.
    local target_path="${install_directory}/${binary_name}"
    if [ -x "${target_path}" ]; then
        local installed_version_output
        installed_version_output="$("${target_path}" --version 2>/dev/null | head -n1 || true)"
        if [[ "${installed_version_output}" == *"${version_pattern}"* ]]; then
            echo "${tool_name} already at pinned version ${pinned_version}"
            return 0
        fi
    fi

    local work_directory
    work_directory="$(mktemp -d "${cache_directory}/${tool_name}.XXXXXX")"
    local archive_path="${work_directory}/archive.tar.gz"

    download_with_retries "${archive_path}" "${archive_url}"
    tar -xzf "${archive_path}" -C "${work_directory}"

    local extracted_binary
    extracted_binary="$(find "${work_directory}" -type f -name "${binary_name}" | head -n1)"
    if [ -z "${extracted_binary}" ] || [ ! -f "${extracted_binary}" ]; then
        echo "${tool_name} binary '${binary_name}' missing from archive." >&2
        rm -rf "${work_directory}"
        exit 1
    fi

    chmod 755 "${extracted_binary}"
    mv "${extracted_binary}" "${target_path}"
    rm -rf "${work_directory}"

    local installed_version_output
    installed_version_output="$("${target_path}" --version 2>/dev/null | head -n1 || true)"
    if [[ "${installed_version_output}" != *"${version_pattern}"* ]]; then
        echo "${tool_name} install finished, but version is '${installed_version_output}' (expected '${pinned_version}')" >&2
        exit 1
    fi

    echo "${tool_name} installed at pinned version ${pinned_version}"
}

ensure_pinned_oh_my_posh() {
    local architecture
    architecture="$(uname -m)"
    local oh_my_posh_asset
    case "${architecture}" in
        x86_64|amd64)
            oh_my_posh_asset='posh-linux-amd64'
            ;;
        aarch64|arm64)
            oh_my_posh_asset='posh-linux-arm64'
            ;;
        *)
            echo "Unsupported architecture for pinned Oh My Posh: ${architecture}" >&2
            exit 1
            ;;
    esac

    local target_path="${install_directory}/oh-my-posh"
    local installed_oh_my_posh_version=''
    if [ -x "${target_path}" ]; then
        installed_oh_my_posh_version="$("${target_path}" version 2>/dev/null || true)"
    fi

    if [ "${installed_oh_my_posh_version}" = "${preferred_oh_my_posh_version}" ]; then
        echo "Oh My Posh already at pinned version ${preferred_oh_my_posh_version}"
        return 0
    fi

    local download_url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/v${preferred_oh_my_posh_version}/${oh_my_posh_asset}"
    local temporary_path
    temporary_path="$(mktemp)"

    echo "Installing pinned Oh My Posh ${preferred_oh_my_posh_version} from ${download_url}"
    download_with_retries "${temporary_path}" "${download_url}"
    chmod 755 "${temporary_path}"
    mv "${temporary_path}" "${target_path}"

    installed_oh_my_posh_version="$("${target_path}" version 2>/dev/null || true)"
    if [ "${installed_oh_my_posh_version}" != "${preferred_oh_my_posh_version}" ]; then
        echo "Oh My Posh install finished, but version is '${installed_oh_my_posh_version}' (expected '${preferred_oh_my_posh_version}')" >&2
        exit 1
    fi
}

ensure_pinned_cli_tools() {
    local musl_target
    local delta_target
    local mise_arch
    local architecture
    musl_target="$(linux_musl_target_triple)"
    delta_target="$(delta_linux_target_triple)"
    architecture="$(uname -m)"
    case "${architecture}" in
        x86_64|amd64)
            mise_arch='linux-x64-musl'
            ;;
        aarch64|arm64)
            mise_arch='linux-arm64-musl'
            ;;
        *)
            echo "Unsupported architecture for mise: ${architecture}" >&2
            exit 1
            ;;
    esac

    install_pinned_tarball_binary \
        'mise' \
        "${preferred_mise_version}" \
        "https://github.com/jdx/mise/releases/download/v${preferred_mise_version}/mise-v${preferred_mise_version}-${mise_arch}.tar.gz" \
        'mise' \
        "${preferred_mise_version}"

    install_pinned_tarball_binary \
        'just' \
        "${preferred_just_version}" \
        "https://github.com/casey/just/releases/download/${preferred_just_version}/just-${preferred_just_version}-${musl_target}.tar.gz" \
        'just' \
        "${preferred_just_version}"

    install_pinned_tarball_binary \
        'zoxide' \
        "${preferred_zoxide_version}" \
        "https://github.com/ajeetdsouza/zoxide/releases/download/v${preferred_zoxide_version}/zoxide-${preferred_zoxide_version}-${musl_target}.tar.gz" \
        'zoxide' \
        "${preferred_zoxide_version}"

    install_pinned_tarball_binary \
        'ripgrep' \
        "${preferred_ripgrep_version}" \
        "https://github.com/BurntSushi/ripgrep/releases/download/${preferred_ripgrep_version}/ripgrep-${preferred_ripgrep_version}-${musl_target}.tar.gz" \
        'rg' \
        "${preferred_ripgrep_version}"

    install_pinned_tarball_binary \
        'fd' \
        "${preferred_fd_version}" \
        "https://github.com/sharkdp/fd/releases/download/v${preferred_fd_version}/fd-v${preferred_fd_version}-${musl_target}.tar.gz" \
        'fd' \
        "${preferred_fd_version}"

    install_pinned_tarball_binary \
        'git-delta' \
        "${preferred_git_delta_version}" \
        "https://github.com/dandavison/delta/releases/download/${preferred_git_delta_version}/delta-${preferred_git_delta_version}-${delta_target}.tar.gz" \
        'delta' \
        "${preferred_git_delta_version}"
}

ensure_agy() {
    local target_path="${install_directory}/agy"
    if [ -x "${target_path}" ]; then
        echo "agy already installed at ${target_path}"
        return 0
    fi

    local installer_path="${cache_directory}/agy-install.sh"
    local partial_path="${installer_path}.partial"
    local installer_url="https://antigravity.google/cli/install.sh"
    if ! curl -fsSL --retry 3 --retry-delay 2 \
        --output "${partial_path}" "${installer_url}"; then
        rm -f "${partial_path}" 2>/dev/null || true
        echo "Warning: could not download the agy installer." >&2
        return 0
    fi

    if ! mv "${partial_path}" "${installer_path}"; then
        rm -f "${partial_path}" 2>/dev/null || true
        echo "Warning: could not save the agy installer." >&2
        return 0
    fi

    local scratch_home
    if ! scratch_home="$(mktemp -d)"; then
        echo "Warning: could not create a temporary HOME for the agy installer." >&2
        return 0
    fi

    # The installer always appends PATH exports to shell rc files; ~/.local/bin
    # is already on PATH via the dotfiles, so send its rc edits to a scratch HOME.
    local installer_status=0
    if ! HOME="${scratch_home}" bash "${installer_path}" --dir "${install_directory}"; then
        installer_status=1
    fi

    if ! rm -rf "${scratch_home}"; then
        echo "Warning: could not remove the agy installer scratch HOME ${scratch_home}." >&2
    fi

    if [ "${installer_status}" -ne 0 ]; then
        echo "Warning: the agy installer failed." >&2
        return 0
    fi

    if [ ! -x "${target_path}" ]; then
        echo "Warning: the agy installer did not create ${target_path}." >&2
    fi
}
ensure_pinned_nerd_fonts() {
    local pinned_version="$1"
    local font_dir="${HOME}/.local/share/fonts/NerdFonts/CaskaydiaCove"
    local version_file="${font_dir}/.installed-version"

    if [[ -d "${font_dir}" && -f "${version_file}" ]]; then
        local installed_version
        installed_version="$(tr -d '[:space:]' < "${version_file}" 2>/dev/null || true)"
        if [[ "${installed_version}" == "${pinned_version}" ]]; then
            return 0
        fi
    fi

    echo "Installing pinned CaskaydiaCove Nerd Font ${pinned_version}"
    local download_url="https://github.com/ryanoasis/nerd-fonts/releases/download/v${pinned_version}/CascadiaCode.zip"
    local work_dir
    if ! work_dir="$(mktemp -d)"; then
        echo "Warning: could not create a temporary directory for Nerd Fonts." >&2
        return 0
    fi
    local archive_path="${work_dir}/CascadiaCode.zip"

    if ! download_with_retries "${archive_path}" "${download_url}"; then
        echo "Warning: could not download CaskaydiaCove Nerd Font." >&2
        rm -rf "${work_dir}"
        return 0
    fi

    mkdir -p "${font_dir}"
    if ! unzip -q -o "${archive_path}" '*.ttf' -d "${font_dir}"; then
        echo "Warning: could not extract CaskaydiaCove Nerd Font." >&2
        rm -rf "${work_dir}"
        return 0
    fi
    printf '%s\n' "${pinned_version}" > "${version_file}"
    rm -rf "${work_dir}"

    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f "${HOME}/.local/share/fonts" || true
    fi
}

{{ if $isWsl -}}
ensure_wsl_windows_nerd_fonts() {
    local pinned_version="$1"
    local localappdata=""
    if command -v wslvar >/dev/null 2>&1; then
        localappdata="$(wslvar LOCALAPPDATA 2>/dev/null || true)"
    fi
    if [[ -z "${localappdata}" && -x /mnt/c/Windows/System32/cmd.exe ]]; then
        localappdata="$(/mnt/c/Windows/System32/cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r\n' || true)"
    fi
    [[ -n "${localappdata}" ]] || return 0

    local win_fonts_dir
    win_fonts_dir="$(wslpath "${localappdata}/Microsoft/Windows/Fonts" 2>/dev/null || true)"
    [[ -n "${win_fonts_dir}" ]] || return 0
    mkdir -p "${win_fonts_dir}"

    local version_file="${win_fonts_dir}/.caskaydiacove-nerd-font-version"
    local installed_version=""
    if [[ -f "${version_file}" ]]; then
        installed_version="$(tr -d '[:space:]' < "${version_file}" 2>/dev/null || true)"
    fi
    if [[ "${installed_version}" != "${pinned_version}" ]]; then
        local font_src_dir="${HOME}/.local/share/fonts/NerdFonts/CaskaydiaCove"
        if [[ -d "${font_src_dir}" ]]; then
            cp -f "${font_src_dir}"/*.ttf "${win_fonts_dir}/" 2>/dev/null || true
            printf '%s\n' "${pinned_version}" > "${version_file}" 2>/dev/null || true
        fi
    fi

    if [[ -x /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]]; then
        /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -Command '
            $ErrorActionPreference = "SilentlyContinue"
            Add-Type -AssemblyName PresentationCore -ErrorAction SilentlyContinue

            $win32Type = @"
using System;
using System.Runtime.InteropServices;
public class FontHelper {
    [DllImport("gdi32.dll", SetLastError = true, CharSet = CharSet.Auto)]
    public static extern int AddFontResource(string lpFileName);

    [DllImport("user32.dll", SetLastError = true, CharSet = CharSet.Auto)]
    public static extern IntPtr SendMessage(IntPtr hWnd, uint Msg, IntPtr wParam, IntPtr lParam);
}
"@
            Add-Type -TypeDefinition $win32Type -ErrorAction SilentlyContinue

            $FontsDir = Join-Path $env:LOCALAPPDATA "Microsoft\Windows\Fonts"
            $RegKey = "HKCU:\Software\Microsoft\Windows NT\CurrentVersion\Fonts"
            $TtfFiles = Get-ChildItem -Path $FontsDir -Filter "CaskaydiaCove*.ttf" -ErrorAction SilentlyContinue

            foreach ($file in $TtfFiles) {
                try {
                    [FontHelper]::AddFontResource($file.FullName) | Out-Null
                } catch {}

                $fontUri = New-Object System.Uri($file.FullName)
                try {
                    $gt = New-Object System.Windows.Media.GlyphTypeface($fontUri)
                    $win32Family = $gt.Win32FamilyNames.Values | Select-Object -First 1
                    $win32Face = $gt.Win32FaceNames.Values | Select-Object -First 1
                    $regName = if ($win32Face -eq "Regular") { "$win32Family (TrueType)" } else { "$win32Family $win32Face (TrueType)" }
                    Set-ItemProperty -Path $RegKey -Name $regName -Value $file.FullName -Type String -Force | Out-Null
                    foreach ($fam in $gt.FamilyNames.Values) {
                        if ($fam -ne $win32Family) {
                            $regName2 = if ($win32Face -eq "Regular") { "$fam (TrueType)" } else { "$fam $win32Face (TrueType)" }
                            Set-ItemProperty -Path $RegKey -Name $regName2 -Value $file.FullName -Type String -Force | Out-Null
                        }
                    }
                } catch {}
            }

            try {
                $HWND_BROADCAST = [IntPtr]0xffff
                $WM_FONTCHANGE = 0x001D
                [FontHelper]::SendMessage($HWND_BROADCAST, $WM_FONTCHANGE, [IntPtr]::Zero, [IntPtr]::Zero) | Out-Null
            } catch {}

            $utf8NoBom = New-Object System.Text.UTF8Encoding($false)

            $wtPaths = @(
                (Join-Path $env:LOCALAPPDATA "Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"),
                (Join-Path $env:LOCALAPPDATA "Packages\Microsoft.WindowsTerminalPreview_8wekyb3d8bbwe\LocalState\settings.json"),
                (Join-Path $env:LOCALAPPDATA "Microsoft\Windows Terminal\settings.json")
            )

            foreach ($wtPath in $wtPaths) {
                if (Test-Path -LiteralPath $wtPath) {
                    try {
                        $settings = Get-Content -LiteralPath $wtPath -Raw | ConvertFrom-Json
                        if (-not $settings.profiles.defaults) {
                            $settings.profiles.defaults = [pscustomobject]@{}
                        }
                        if (-not $settings.profiles.defaults.font) {
                            $settings.profiles.defaults | Add-Member -NotePropertyName font -NotePropertyValue ([pscustomobject]@{}) -Force
                        }
                        $settings.profiles.defaults.font | Add-Member -NotePropertyName face -NotePropertyValue "CaskaydiaCove NF" -Force

                        if ($settings.profiles.list) {
                            foreach ($profile in $settings.profiles.list) {
                                if ($profile.font -and $profile.font.face -eq "CaskaydiaCove Nerd Font") {
                                    $profile.font.face = "CaskaydiaCove NF"
                                }
                                if ($profile.name -like "*Ubuntu*" -or $profile.source -in @("Microsoft.WSL", "Windows.Terminal.Wsl")) {
                                    if (-not $profile.font) {
                                        $profile | Add-Member -NotePropertyName font -NotePropertyValue ([pscustomobject]@{}) -Force
                                    }
                                    $profile.font | Add-Member -NotePropertyName face -NotePropertyValue "CaskaydiaCove NF" -Force
                                }
                            }
                        }

                        $jsonContent = $settings | ConvertTo-Json -Depth 32
                        [System.IO.File]::WriteAllText($wtPath, $jsonContent + [Environment]::NewLine, $utf8NoBom)
                    } catch {}
                }
            }

            $editorPaths = [System.Collections.Generic.List[string]]::new()
            $knownEditors = @("Cursor", "Devin", "Antigravity", "Antigravity IDE", "Code")
            foreach ($ed in $knownEditors) {
                $p = Join-Path $env:APPDATA "$ed\User\settings.json"
                if (Test-Path -LiteralPath $p) { $editorPaths.Add($p) }
            }
            $discovered = Get-ChildItem -Path $env:APPDATA -Directory -ErrorAction SilentlyContinue | Where-Object {
                Test-Path (Join-Path $_.FullName "User\settings.json")
            }
            foreach ($d in $discovered) {
                $p = Join-Path $d.FullName "User\settings.json"
                if (-not $editorPaths.Contains($p)) { $editorPaths.Add($p) }
            }
            $q = [char]39
            $targetFont = "${q}CaskaydiaCove NF${q}, ${q}CaskaydiaCove Nerd Font${q}"

            foreach ($p in $editorPaths) {
                try {
                    $s = Get-Content -LiteralPath $p -Raw | ConvertFrom-Json
                    $s | Add-Member -NotePropertyName "terminal.integrated.fontFamily" -NotePropertyValue $targetFont -Force
                    $json = $s | ConvertTo-Json -Depth 32
                    [System.IO.File]::WriteAllText($p, $json + [Environment]::NewLine, $utf8NoBom)
                } catch {}
            }
        ' >/dev/null 2>&1 || true
    fi

    local srv
    for srv in "${HOME}/.vscode-server" "${HOME}/.cursor-server" "${HOME}/.devin-server" "${HOME}/.antigravity-server"; do
        if [[ -d "${srv}" ]]; then
            local subdir
            for subdir in User Machine; do
                mkdir -p "${srv}/data/${subdir}"
                local settings_file="${srv}/data/${subdir}/settings.json"
                if [[ ! -f "${settings_file}" ]]; then
                    printf '{\n  "terminal.integrated.fontFamily": "\x27CaskaydiaCove NF\x27, \x27CaskaydiaCove Nerd Font\x27"\n}\n' > "${settings_file}"
                fi
            done
        fi
    done
}
{{ end -}}

sudo apt-get update
sudo apt-get install -y \
    curl \
    fontconfig \
    fzf \
    jq \
    shellcheck \
    software-properties-common \
    unzip \
    zsh \
    zsh-autosuggestions \
    zsh-syntax-highlighting

{{ if $isWsl -}}
if ! sudo apt-get install -y wslu; then
    echo "Warning: could not install optional WSL browser integration (wslu)." >&2
fi
{{ else -}}
if ! sudo apt-get install -y xdg-utils wl-clipboard; then
    echo "Warning: could not install optional native Linux browser/clipboard tools." >&2
fi
{{ end -}}

ensure_modern_git
ensure_pinned_oh_my_posh
ensure_pinned_cli_tools
ensure_agy
ensure_pinned_nerd_fonts "${preferred_nerd_fonts_version}"
{{ if $isWsl -}}
ensure_wsl_windows_nerd_fonts "${preferred_nerd_fonts_version}"
{{ end -}}
if ! "${install_directory}/mise" install --yes; then
    echo "Warning: mise could not install global tools." >&2
fi
{{ end -}}
