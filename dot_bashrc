# Managed bashrc: minimal fallback shell. Primary interactive shell is zsh.

case $- in
    *i*) ;;
    *) return ;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend
shopt -s checkwinsize

export PATH="$HOME/.local/bin:$PATH"

if [ -f "$HOME/.config/shell/helpers.sh" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.config/shell/helpers.sh"
fi

if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

if [ -f /usr/share/doc/fzf/examples/key-bindings.bash ]; then
    # shellcheck source=/dev/null
    . /usr/share/doc/fzf/examples/key-bindings.bash
elif [ -f /usr/share/fzf/key-bindings.bash ]; then
    # shellcheck source=/dev/null
    . /usr/share/fzf/key-bindings.bash
fi

if [ -f /usr/share/doc/fzf/examples/completion.bash ]; then
    # shellcheck source=/dev/null
    . /usr/share/doc/fzf/examples/completion.bash
elif [ -f /usr/share/fzf/completion.bash ]; then
    # shellcheck source=/dev/null
    . /usr/share/fzf/completion.bash
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

expected_oh_my_posh_version_file="$HOME/.config/oh-my-posh/expected-version"
if command -v oh-my-posh >/dev/null 2>&1 && [ -f "$expected_oh_my_posh_version_file" ]; then
    expected_oh_my_posh_version="$(tr -d '[:space:]' < "$expected_oh_my_posh_version_file")"
    installed_oh_my_posh_version="$(oh-my-posh version 2>/dev/null || true)"
    if [ "$installed_oh_my_posh_version" = "$expected_oh_my_posh_version" ]; then
        eval "$(oh-my-posh init bash --config "$HOME/.config/oh-my-posh/theme.omp.json")"
    else
        printf 'warning: Oh My Posh %s does not match pinned %s; run the dotfiles bootstrap.\n' \
            "${installed_oh_my_posh_version:-unknown}" \
            "$expected_oh_my_posh_version" >&2
    fi
elif command -v oh-my-posh >/dev/null 2>&1; then
    printf 'warning: pinned Oh My Posh version file missing; run the dotfiles bootstrap.\n' >&2
fi
