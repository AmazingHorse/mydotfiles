Host *
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Machine-local or sensitive hosts go here and stay out of git:
#   ~/.ssh/config.d/private.conf
Include config.d/*.conf
