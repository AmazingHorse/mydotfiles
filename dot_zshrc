# Managed zshrc: primary interactive shell on Linux/WSL.

export PATH="$HOME/.local/bin:$PATH"

if [ -f "$HOME/.config/shell/helpers.sh" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.config/shell/helpers.sh"
fi

HISTFILE="$HOME/.zsh_history"
HISTSIZE=5000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS

autoload -Uz compinit
compinit

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/doc/fzf/examples/key-bindings.zsh
elif [ -f /usr/share/fzf/key-bindings.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/fzf/key-bindings.zsh
fi

if [ -f /usr/share/doc/fzf/examples/completion.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/doc/fzf/examples/completion.zsh
elif [ -f /usr/share/fzf/completion.zsh ]; then
    # shellcheck source=/dev/null
    . /usr/share/fzf/completion.zsh
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

expected_oh_my_posh_version_file="$HOME/.config/oh-my-posh/expected-version"
if command -v oh-my-posh >/dev/null 2>&1 && [ -f "$expected_oh_my_posh_version_file" ]; then
    expected_oh_my_posh_version="$(tr -d '[:space:]' < "$expected_oh_my_posh_version_file")"
    installed_oh_my_posh_version="$(oh-my-posh version 2>/dev/null || true)"
    if [ "$installed_oh_my_posh_version" = "$expected_oh_my_posh_version" ]; then
        eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/theme.omp.json")"
    else
        printf 'warning: Oh My Posh %s does not match pinned %s; run the dotfiles bootstrap.\n' \
            "${installed_oh_my_posh_version:-unknown}" \
            "$expected_oh_my_posh_version" >&2
    fi
elif command -v oh-my-posh >/dev/null 2>&1; then
    printf 'warning: pinned Oh My Posh version file missing; run the dotfiles bootstrap.\n' >&2
fi
