# Agent API secrets. Sourced by ~/.config/agent-env.sh.
# Managed by chezmoi. Local overrides go in ~/.config/agent-env.local.sh.

{{- if and (eq .profile "workstation") (lookPath "bw") (env "BW_SESSION") }}
{{-   $bwItem := (bitwarden "item" "ai-agent-keys") }}
{{-   if $bwItem }}
{{-     range $bwItem.fields }}
export {{ .name }}={{ .value | quote }}
{{-     end }}
{{-   end }}
{{- end }}
