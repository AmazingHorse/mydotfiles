{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "foreground": "#d3c6aa",
          "background": "#425047",
          "template": " {{ .Icon }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#2d353b",
          "background": "#a7c080",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#2d353b",
          "background": "#83c092",
          "template": " \ue5ff  {{ .Path }} ",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#2d353b",
          "background": "#dbbc7f",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e69875{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#e67e80{{ end }}",
            "{{ if gt .Ahead 0 }}#7fbbb3{{ end }}",
            "{{ if gt .Behind 0 }}#d699b6{{ end }}"
          ],
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} "
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#2d353b",
          "background": "#e67e80",
          "template": " \uf0e7 "
        },
        {
          "type": "exit",
          "style": "diamond",
          "foreground": "#2d353b",
          "background": "#a7c080",
          "background_templates": [
            "{{ if gt .Code 0 }}#e67e80{{ end }}"
          ],
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}\uf00d {{ .Code }}{{ else }}\uf00c{{ end }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#d3c6aa",
          "template": " \uf252 {{ .FormattedMs }} ",
          "properties": {
            "threshold": 500
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#859289",
          "template": " {{ .CurrentDate | date .Format }} ",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#a7c080",
          "template": "\u276f "
        }
      ]
    }
  ],
  "transient_prompt": {
    "foreground": "#a7c080",
    "template": "\u276f "
  }
}
