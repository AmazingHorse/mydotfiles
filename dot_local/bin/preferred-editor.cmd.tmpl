{{ if eq .chezmoi.os "windows" -}}
@echo off
setlocal EnableExtensions

rem PREFERRED_EDITOR overrides the pinned nvim (e.g. set PREFERRED_EDITOR=code --wait)
if defined PREFERRED_EDITOR (
  call %PREFERRED_EDITOR% %*
  exit /b %ERRORLEVEL%
)

where nvim >nul 2>&1
if %ERRORLEVEL%==0 (
  nvim %*
  exit /b %ERRORLEVEL%
)

where vim >nul 2>&1
if %ERRORLEVEL%==0 (
  vim %*
  exit /b %ERRORLEVEL%
)

where vi >nul 2>&1
if %ERRORLEVEL%==0 (
  vi %*
  exit /b %ERRORLEVEL%
)

echo preferred-editor: no supported editor found on PATH 1>&2
exit /b 1
{{ end -}}
