#!/usr/bin/env bash
# Pick an editor: PREFERRED_EDITOR (command + optional args) wins, then the
# pinned nvim, then whatever terminal editor the base OS ships. GUI editors
# are intentionally out of the chain — WSL interop shims go stale and are
# slow to boot. Opt back in per-machine with PREFERRED_EDITOR='code --wait'.
set -euo pipefail

if [ -n "${PREFERRED_EDITOR:-}" ]; then
    read -r -a preferred_editor <<< "${PREFERRED_EDITOR}"
    if command -v "${preferred_editor[0]}" >/dev/null 2>&1; then
        exec "${preferred_editor[@]}" "$@"
    fi
    printf 'preferred-editor: %s not found; falling back\n' "${preferred_editor[0]}" >&2
fi

for editor in nvim vim vi nano; do
    if command -v "${editor}" >/dev/null 2>&1; then
        exec "${editor}" "$@"
    fi
done

printf 'preferred-editor: no supported editor found on PATH\n' >&2
exit 1
