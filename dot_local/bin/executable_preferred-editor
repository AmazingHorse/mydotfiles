#!/usr/bin/env bash
# Pick the first available GUI/terminal editor and wait for it (Git-friendly).
set -euo pipefail

try_wait_editor() {
    local command_name="$1"
    shift

    if ! command -v "${command_name}" >/dev/null 2>&1; then
        return 1
    fi

    exec "${command_name}" "$@"
}

try_wait_editor cursor --wait "$@"
try_wait_editor antigravity --wait "$@"
try_wait_editor agy --wait "$@"
try_wait_editor code --wait "$@"
try_wait_editor nvim "$@"
try_wait_editor vim "$@"
try_wait_editor vi "$@"

printf 'preferred-editor: no supported editor found on PATH\n' >&2
exit 1
