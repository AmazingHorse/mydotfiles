{{ if eq .chezmoi.os "windows" -}}
# Install pinned shell dependencies and wire PowerShell 7 to the managed profile.

$ErrorActionPreference = 'Stop'

$PinnedOhMyPoshVersion = '{{ .packages.oh_my_posh }}'
$PinnedGitVersion = '{{ .packages.git }}'
$PinnedMiseVersion = '{{ .packages.mise }}'
$PinnedJustVersion = '{{ .packages.just }}'
$PinnedZoxideVersion = '{{ .packages.zoxide }}'
$PinnedRipgrepVersion = '{{ .packages.ripgrep }}'
$PinnedFdVersion = '{{ .packages.fd }}'
$PinnedGitDeltaVersion = '{{ .packages.git_delta }}'

function Get-OhMyPoshInstalledVersion {
    $OhMyPoshCommand = Get-Command oh-my-posh -ErrorAction SilentlyContinue
    if (-not $OhMyPoshCommand) {
        return $null
    }

    try {
        $VersionOutput = & $OhMyPoshCommand.Source version 2>$null | Select-Object -First 1
        return $VersionOutput.Trim()
    } catch {
        return $null
    }
}

function Get-GitInstalledSemVer {
    $GitCommand = Get-Command git -ErrorAction SilentlyContinue
    if (-not $GitCommand) {
        return $null
    }

    try {
        $VersionOutput = & $GitCommand.Source version 2>$null | Select-Object -First 1
        if ($VersionOutput -match 'git version (\d+\.\d+\.\d+)') {
            return $Matches[1]
        }
        return $null
    } catch {
        return $null
    }
}

function Refresh-ProcessPathFromMachineAndUser {
    $env:Path = [System.Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' +
        [System.Environment]::GetEnvironmentVariable('Path', 'User')
}

function Initialize-ManagedLocalBin {
    param(
        [Parameter(Mandatory = $true)]
        [string]$InstallDirectory
    )

    if (-not (Test-Path -LiteralPath $InstallDirectory)) {
        New-Item -ItemType Directory -Force -Path $InstallDirectory | Out-Null
    }

    if (-not (($env:Path -split ';') -contains $InstallDirectory)) {
        $env:Path = "$InstallDirectory;$env:Path"
    }
}

function Get-ManagedDownloadCacheDirectory {
    $CacheDirectory = Join-Path $HOME '.cache\mydotfiles\downloads'
    if (-not (Test-Path -LiteralPath $CacheDirectory)) {
        New-Item -ItemType Directory -Force -Path $CacheDirectory | Out-Null
    }
    return $CacheDirectory
}

function Get-BinaryVersionLine {
    param(
        [Parameter(Mandatory = $true)]
        [string]$BinaryPath,

        [string[]]$VersionArguments = @('--version')
    )

    if (-not (Test-Path -LiteralPath $BinaryPath)) {
        return $null
    }

    try {
        $VersionOutput = & $BinaryPath @VersionArguments 2>$null | Select-Object -First 1
        if ($VersionOutput) {
            return [string]$VersionOutput
        }
        return $null
    } catch {
        return $null
    }
}

function Test-ManagedPinnedBinary {
    # Path-first pin check: never rely on Get-Command / PATH for ~/.local/bin tools.
    param(
        [Parameter(Mandatory = $true)]
        [string]$BinaryPath,

        [Parameter(Mandatory = $true)]
        [string]$PinnedVersion,

        [string[]]$CompanionPaths = @(),

        [string[]]$VersionArguments = @('--version')
    )

    if (-not (Test-Path -LiteralPath $BinaryPath)) {
        return $false
    }

    foreach ($CompanionPath in $CompanionPaths) {
        if (-not (Test-Path -LiteralPath $CompanionPath)) {
            return $false
        }
    }

    $VersionOutput = Get-BinaryVersionLine -BinaryPath $BinaryPath -VersionArguments $VersionArguments
    if (-not $VersionOutput) {
        return $false
    }

    return [bool]($VersionOutput -match [regex]::Escape($PinnedVersion))
}

function Install-ManagedZipRelease {
    # Download a GitHub zip into ~/.cache/mydotfiles/downloads, extract named
    # binaries into InstallDirectory, then remove the work directory.
    param(
        [Parameter(Mandatory = $true)]
        [string]$ToolName,

        [Parameter(Mandatory = $true)]
        [string]$PinnedVersion,

        [Parameter(Mandatory = $true)]
        [string]$DownloadUrl,

        [Parameter(Mandatory = $true)]
        [string]$AssetName,

        [Parameter(Mandatory = $true)]
        [string]$InstallDirectory,

        [Parameter(Mandatory = $true)]
        [hashtable]$BinaryNameToDestinationPath
    )

    Initialize-ManagedLocalBin -InstallDirectory $InstallDirectory

    $CacheDirectory = Get-ManagedDownloadCacheDirectory
    $WorkDirectory = Join-Path $CacheDirectory (
        '{0}-{1}-{2}' -f $ToolName, $PinnedVersion, [Guid]::NewGuid().ToString('N')
    )
    $ArchivePath = Join-Path $WorkDirectory $AssetName

    New-Item -ItemType Directory -Force -Path $WorkDirectory | Out-Null
    try {
        Write-Host "Installing pinned $ToolName $PinnedVersion from $DownloadUrl"
        Invoke-WebRequest -Uri $DownloadUrl -OutFile $ArchivePath
        Expand-Archive -LiteralPath $ArchivePath -DestinationPath $WorkDirectory -Force

        foreach ($BinaryName in $BinaryNameToDestinationPath.Keys) {
            $DestinationPath = $BinaryNameToDestinationPath[$BinaryName]
            $ExtractedBinary = Get-ChildItem -Path $WorkDirectory -Filter $BinaryName -Recurse |
                Select-Object -First 1
            if (-not $ExtractedBinary) {
                throw "$BinaryName missing from $AssetName"
            }
            Move-Item -LiteralPath $ExtractedBinary.FullName -Destination $DestinationPath -Force
        }
    } finally {
        Remove-Item -LiteralPath $WorkDirectory -Recurse -Force -ErrorAction SilentlyContinue
    }

    Refresh-ProcessPathFromMachineAndUser
    Initialize-ManagedLocalBin -InstallDirectory $InstallDirectory
}

function Ensure-PinnedOhMyPosh {
    param(
        [Parameter(Mandatory = $true)]
        [string]$PinnedVersion
    )

    $InstalledVersion = Get-OhMyPoshInstalledVersion
    if ($InstalledVersion -eq $PinnedVersion) {
        Write-Host "Oh My Posh already at pinned version $PinnedVersion"
        return
    }

    if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
        throw "winget is required to install Oh My Posh $PinnedVersion"
    }

    if ($InstalledVersion) {
        Write-Host "Replacing Oh My Posh $InstalledVersion with pinned $PinnedVersion"
    } else {
        Write-Host "Installing pinned Oh My Posh $PinnedVersion"
    }

    winget install `
        --id JanDeDobbeleer.OhMyPosh `
        --exact `
        --version $PinnedVersion `
        --scope user `
        --force `
        --silent `
        --accept-package-agreements `
        --accept-source-agreements `
        --source winget

    Refresh-ProcessPathFromMachineAndUser

    $InstalledVersion = Get-OhMyPoshInstalledVersion
    if ($InstalledVersion -ne $PinnedVersion) {
        throw "Oh My Posh install finished, but version is '$InstalledVersion' (expected '$PinnedVersion')"
    }
}

function Ensure-PinnedGit {
    param(
        [Parameter(Mandatory = $true)]
        [string]$PinnedVersion
    )

    $InstalledSemVer = Get-GitInstalledSemVer
    if ($InstalledSemVer -eq $PinnedVersion) {
        Write-Host "Git already at pinned version $PinnedVersion"
        return
    }

    if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
        throw "winget is required to install Git $PinnedVersion"
    }

    if ($InstalledSemVer) {
        Write-Host "Replacing Git $InstalledSemVer with pinned $PinnedVersion"
    } else {
        Write-Host "Installing pinned Git $PinnedVersion"
    }

    # Git for Windows package versions are often x.y.z or x.y.z.N; pin the
    # exact winget release that matches our semantic packages.git value.
    winget install `
        --id Git.Git `
        --exact `
        --version $PinnedVersion `
        --force `
        --silent `
        --accept-package-agreements `
        --accept-source-agreements `
        --source winget

    Refresh-ProcessPathFromMachineAndUser

    $InstalledSemVer = Get-GitInstalledSemVer
    if ($InstalledSemVer -ne $PinnedVersion) {
        throw "Git install finished, but version is '$InstalledSemVer' (expected '$PinnedVersion')"
    }
}

function Ensure-WingetPackagePresent {
    param(
        [Parameter(Mandatory = $true)]
        [string]$PackageId,

        [string]$PinnedVersion
    )

    $installedPackages = winget list --id $PackageId --accept-source-agreements 2>$null
    if ($LASTEXITCODE -eq 0 -and ($installedPackages -match [regex]::Escape($PackageId))) {
        if (-not $PinnedVersion -or ($installedPackages -match [regex]::Escape($PinnedVersion))) {
            Write-Host "Already installed: $PackageId$(if ($PinnedVersion) { " $PinnedVersion" })"
            return
        }
    }

    Write-Host "Installing: $PackageId$(if ($PinnedVersion) { " $PinnedVersion" })"
    $WingetArguments = @(
        'install'
        '--id', $PackageId
        '--exact'
        '--silent'
        '--accept-package-agreements'
        '--accept-source-agreements'
        '--source', 'winget'
    )
    if ($PinnedVersion) {
        $WingetArguments += @('--version', $PinnedVersion, '--force')
    }

    winget @WingetArguments
    Refresh-ProcessPathFromMachineAndUser
}

function Ensure-PinnedMise {
    param(
        [Parameter(Mandatory = $true)]
        [string]$PinnedVersion,

        [Parameter(Mandatory = $true)]
        [string]$InstallDirectory
    )

    Initialize-ManagedLocalBin -InstallDirectory $InstallDirectory

    $TargetPath = Join-Path $InstallDirectory 'mise.exe'
    $ShimPath = Join-Path $InstallDirectory 'mise-shim.exe'

    if (Test-ManagedPinnedBinary `
            -BinaryPath $TargetPath `
            -PinnedVersion $PinnedVersion `
            -CompanionPaths @($ShimPath)) {
        Write-Host "mise already at pinned version $PinnedVersion (with mise-shim.exe)"
        return
    }

    $Architecture = [System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture
    $MiseArch = switch ($Architecture) {
        'X64' { 'windows-x64' }
        'Arm64' { 'windows-arm64' }
        default { throw "Unsupported architecture for mise: $Architecture" }
    }

    $AssetName = "mise-v${PinnedVersion}-${MiseArch}.zip"
    $DownloadUrl = "https://github.com/jdx/mise/releases/download/v${PinnedVersion}/${AssetName}"

    Install-ManagedZipRelease `
        -ToolName 'mise' `
        -PinnedVersion $PinnedVersion `
        -DownloadUrl $DownloadUrl `
        -AssetName $AssetName `
        -InstallDirectory $InstallDirectory `
        -BinaryNameToDestinationPath @{
            'mise.exe' = $TargetPath
            'mise-shim.exe' = $ShimPath
        }

    if (-not (Test-ManagedPinnedBinary `
            -BinaryPath $TargetPath `
            -PinnedVersion $PinnedVersion `
            -CompanionPaths @($ShimPath))) {
        $InstalledVersion = Get-BinaryVersionLine -BinaryPath $TargetPath
        throw "mise install finished, but version is '$InstalledVersion' (expected '$PinnedVersion')"
    }
}

$LocalBinDirectory = Join-Path $HOME '.local\bin'
Initialize-ManagedLocalBin -InstallDirectory $LocalBinDirectory

Ensure-PinnedGit -PinnedVersion $PinnedGitVersion
Ensure-PinnedOhMyPosh -PinnedVersion $PinnedOhMyPoshVersion
Ensure-PinnedMise -PinnedVersion $PinnedMiseVersion -InstallDirectory $LocalBinDirectory

if (Get-Command winget -ErrorAction SilentlyContinue) {
    Ensure-WingetPackagePresent -PackageId 'GitHub.cli'
    Ensure-WingetPackagePresent -PackageId 'junegunn.fzf'
    Ensure-WingetPackagePresent -PackageId 'Casey.Just' -PinnedVersion $PinnedJustVersion
    Ensure-WingetPackagePresent -PackageId 'ajeetdsouza.zoxide' -PinnedVersion $PinnedZoxideVersion
    Ensure-WingetPackagePresent -PackageId 'BurntSushi.ripgrep.MSVC' -PinnedVersion $PinnedRipgrepVersion
    Ensure-WingetPackagePresent -PackageId 'sharkdp.fd' -PinnedVersion $PinnedFdVersion
    Ensure-WingetPackagePresent -PackageId 'dandavison.delta' -PinnedVersion $PinnedGitDeltaVersion
} else {
    Write-Warning 'winget not found; install GitHub CLI / fzf / Tier-1 CLIs manually if needed.'
}

$UserPath = [Environment]::GetEnvironmentVariable('Path', 'User')
if (-not (($UserPath -split ';') -contains $LocalBinDirectory)) {
    [Environment]::SetEnvironmentVariable(
        'Path',
        ($LocalBinDirectory + ';' + $UserPath).TrimEnd(';'),
        'User'
    )
    Write-Host "Added $LocalBinDirectory to the user PATH"
}
Refresh-ProcessPathFromMachineAndUser
Initialize-ManagedLocalBin -InstallDirectory $LocalBinDirectory

$ProfileLoader = @'
# Generated by chezmoi; loads the managed PowerShell profile.
$ManagedProfilePath = Join-Path $HOME '.config\powershell\profile.ps1'
if (Test-Path -LiteralPath $ManagedProfilePath) {
    . $ManagedProfilePath
}
'@

$ProfileTargets = @()
if (Get-Command pwsh -ErrorAction SilentlyContinue) {
    $ProfileTargets = @(
        & pwsh -NoProfile -Command '$PROFILE.CurrentUserAllHosts'
        & pwsh -NoProfile -Command '$PROFILE.CurrentUserCurrentHost'
    ) | Where-Object { $_ } | Select-Object -Unique
}

if (-not $ProfileTargets) {
    $DocumentsPath = [Environment]::GetFolderPath('MyDocuments')
    $ProfileTargets = @(
        Join-Path $DocumentsPath 'PowerShell\profile.ps1'
        Join-Path $DocumentsPath 'PowerShell\Microsoft.PowerShell_profile.ps1'
    )
}

foreach ($ProfileTarget in $ProfileTargets) {
    $ProfileDirectory = Split-Path -Parent $ProfileTarget
    if (-not (Test-Path -LiteralPath $ProfileDirectory)) {
        New-Item -ItemType Directory -Force -Path $ProfileDirectory | Out-Null
    }

    $ShouldWrite = $true
    if (Test-Path -LiteralPath $ProfileTarget) {
        $ExistingContent = Get-Content -LiteralPath $ProfileTarget -Raw
        if ($ExistingContent -like '*.config\powershell\profile.ps1*') {
            $ShouldWrite = $false
        }
    }

    if ($ShouldWrite) {
        Set-Content -LiteralPath $ProfileTarget -Value $ProfileLoader -Encoding UTF8
        Write-Host "Updated PowerShell 7 profile loader: $ProfileTarget"
    } else {
        Write-Host "PowerShell 7 profile already loads managed profile: $ProfileTarget"
    }
}
{{ end -}}
