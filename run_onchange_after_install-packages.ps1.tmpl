{{ if eq .chezmoi.os "windows" -}}
# Install shell dependencies and wire PowerShell 7 to the managed profile.

$ErrorActionPreference = 'Stop'

function Ensure-WingetPackage {
    param(
        [Parameter(Mandatory = $true)]
        [string]$PackageId
    )

    $installedPackages = winget list --id $PackageId --accept-source-agreements 2>$null
    if ($LASTEXITCODE -eq 0 -and ($installedPackages -match [regex]::Escape($PackageId))) {
        Write-Host "Already installed: $PackageId"
        return
    }

    Write-Host "Installing: $PackageId"
    winget install --id $PackageId --exact --accept-package-agreements --accept-source-agreements
}

if (Get-Command winget -ErrorAction SilentlyContinue) {
    Ensure-WingetPackage -PackageId 'JanDeDobbeleer.OhMyPosh'
    Ensure-WingetPackage -PackageId 'GitHub.cli'
} else {
    Write-Warning 'winget not found; install oh-my-posh and GitHub CLI manually if needed.'
}

$ManagedProfilePath = Join-Path $HOME '.config\powershell\profile.ps1'
$ProfileLoader = @"
# Generated by chezmoi; loads the managed PowerShell profile.
`$ManagedProfilePath = Join-Path `$HOME '.config\powershell\profile.ps1'
if (Test-Path -LiteralPath `$ManagedProfilePath) {
    . `$ManagedProfilePath
}
"@

$ProfileTargets = @(
    $PROFILE.CurrentUserAllHosts,
    $PROFILE.CurrentUserCurrentHost
) | Select-Object -Unique

foreach ($ProfileTarget in $ProfileTargets) {
    $ProfileDirectory = Split-Path -Parent $ProfileTarget
    if (-not (Test-Path -LiteralPath $ProfileDirectory)) {
        New-Item -ItemType Directory -Force -Path $ProfileDirectory | Out-Null
    }

    $ShouldWrite = $true
    if (Test-Path -LiteralPath $ProfileTarget) {
        $ExistingContent = Get-Content -LiteralPath $ProfileTarget -Raw
        if ($ExistingContent -like "*$ManagedProfilePath*" -or $ExistingContent -like "*.config\powershell\profile.ps1*") {
            $ShouldWrite = $false
        }
    }

    if ($ShouldWrite) {
        Set-Content -LiteralPath $ProfileTarget -Value $ProfileLoader -Encoding UTF8
        Write-Host "Updated PowerShell profile loader: $ProfileTarget"
    } else {
        Write-Host "PowerShell profile already loads managed profile: $ProfileTarget"
    }
}
{{ end -}}
