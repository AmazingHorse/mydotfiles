[no-cd]
git-guard:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'Error: not inside a git work tree.\n' >&2
        exit 1
    fi
    current_branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
        printf 'Error: on %s branch. Switch to a feature/task branch first.\n' "$current_branch" >&2
        exit 1
    fi
    if ! git check-ignore -q .agent-spec.md 2>/dev/null || ! git check-ignore -q .agent-profile.md 2>/dev/null; then
        printf 'Error: .agent-spec.md and .agent-profile.md must be ignored by git.\n' >&2
        exit 1
    fi
    dirty_count="$(git status --porcelain | grep -c . || true)"
    if [[ "$dirty_count" -gt 0 ]]; then
        printf 'Warning: %s uncommitted file(s) in work tree.\n' "$dirty_count" >&2
    fi

[no-cd]
run-omp model="" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    just --justfile {{quote(justfile())}} git-guard
    if [[ ! -s ./.agent-spec.md ]]; then
        printf 'Missing or empty .agent-spec.md; run omp or generate a spec first.\n' >&2
        exit 1
    fi
    if ! command -v omp >/dev/null 2>&1; then
        printf 'omp is not installed; install it with mise use -g npm:@oh-my-pi/pi-coding-agent\n' >&2
        exit 1
    fi
    model="${1:-}"
    shift || true
    if [[ "$model" == -* ]]; then
        set -- "$model" "$@"
        model=""
    fi
    for arg in "$@"; do
        if [[ "$arg" == "-c" || "$arg" == "--continue" || "$arg" == "-r" || "$arg" == "--resume" ]]; then
            printf 'Error: fresh session required; %s is not permitted in run-omp.\n' "$arg" >&2
            exit 1
        fi
    done
    effective_model="${model:-${OMP_MODEL:-}}"
    cmd=(omp)
    if [[ -n "$effective_model" ]]; then
        cmd+=(--model "$effective_model")
    fi
    cmd+=("$@" @.agent-spec.md)
    exec "${cmd[@]}"

alias omp-run := run-omp

[no-cd]
worktree-new branch:
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run worktree-new inside a git repository.\n' >&2
        exit 1
    fi
    safe_branch="${branch//\//-}"
    worktree_dir="$(dirname "$repo_root")/wt-$safe_branch"
    if [[ -d "$worktree_dir" ]]; then
        printf 'Worktree directory already exists: %s\n' "$worktree_dir" >&2
        exit 1
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$worktree_dir" "$branch"
    else
        git worktree add -b "$branch" "$worktree_dir" HEAD
    fi
    if [[ -f ./.agent-spec.md ]]; then
        cp ./.agent-spec.md "$worktree_dir/.agent-spec.md"
    fi
    if [[ -f ./.agent-profile.md ]]; then
        cp ./.agent-profile.md "$worktree_dir/.agent-profile.md"
    fi
    printf '%s\n' "$worktree_dir"

[no-cd]
worktree-rm branch:
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run worktree-rm inside a git repository.\n' >&2
        exit 1
    fi
    safe_branch="${branch//\//-}"
    worktree_dir="$(dirname "$repo_root")/wt-$safe_branch"
    if [[ ! -d "$worktree_dir" ]]; then
        printf 'Worktree directory does not exist: %s\n' "$worktree_dir" >&2
        exit 1
    fi
    if ! git worktree remove "$worktree_dir"; then
        printf 'Failed to remove worktree %s. If there are uncommitted changes, commit/stash them or remove manually.\n' "$worktree_dir" >&2
        exit 1
    fi
[no-cd]
doctor:
    #!/usr/bin/env bash
    set -euo pipefail
    agent_home={{quote(agent_home)}}
    report_value() {
        printf '%-18s %s\n' "$1" "$2"
    }
    report_value AGENT_ENV "${AGENT_ENV:-"(unset — source ~/.config/agent-env.sh)"}"
    report_value kernel "$(uname -srm)"
    report_value BROWSER "${BROWSER:-"(unset)"}"
    report_value OLLAMA_HOST "${OLLAMA_HOST:-"(unset)"}"
    report_value AGENT_HOME "${AGENT_HOME:-$agent_home}"
    printf '\nactive stack:\n'
    for binary in omp agy just rg node; do
        if binary_path="$(command -v "$binary" 2>/dev/null)"; then
            report_value "$binary" "$binary_path"
        else
            report_value "$binary" missing
        fi
    done
    printf '\nfuture (optional):\n'
    if binary_path="$(command -v devin 2>/dev/null)"; then
        report_value devin "$binary_path"
    else
        report_value devin missing
    fi
    printf '\nskills:\n'
    skills_dir="$agent_home/agent/skills"
    if [[ ! -d "$skills_dir" ]]; then
        report_value skills 'not linked (run: agy-crew install --hosts omp)'
    else
        skill_count=0
        for skill in "$skills_dir"/*; do
            [[ -e "$skill" || -L "$skill" ]] || continue
            skill_count=$((skill_count + 1))
        done
        report_value skills "$skill_count entries"
    fi
    printf '\nagent configuration:\n'
    config_file="$agent_home/agent/config.yml"
    if [[ -f "$config_file" ]] && grep -q 'approvalMode: write' "$config_file"; then
        report_value "approvalMode" "write (configured)"
    else
        report_value "approvalMode" "missing or not write"
    fi
    bootstrap_guard="$agent_home/agent/extensions/bootstrap-guard.ts"
    if [[ -f "$bootstrap_guard" ]]; then
        report_value "bootstrap-guard" "present"
    else
        report_value "bootstrap-guard" "missing"
    fi
    seeds_dir="$agent_home/seeds"
    if [[ ! -d "$seeds_dir" ]]; then
        report_value "seeds" "missing"
    else
        seed_count=0
        for seed_file in "$seeds_dir"/*.md; do
            [[ -f "$seed_file" ]] || continue
            seed_count=$((seed_count + 1))
        done
        report_value "seeds" "$seed_count found"
    fi

[no-cd]
[group('future')]
devin-worktree branch model="devin/swe-1.6":
    #!/usr/bin/env bash
    set -euo pipefail
    agent_home={{quote(agent_home)}}
    branch={{quote(branch)}}
    model={{quote(model)}}
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run devin-worktree inside a git repository.\n' >&2
        exit 1
    fi
    if [[ ! -f ./.agent-spec.md ]]; then
        printf 'Missing .agent-spec.md; run: just -g plan <task>\n' >&2
        exit 1
    fi
    if ! command -v omp >/dev/null 2>&1; then
        printf 'omp is required to run the agent spec.\n' >&2
        exit 1
    fi
    if ! command -v devin >/dev/null 2>&1; then
        printf 'devin-worktree is a future stub for omp → Devin CLI provider integration; devin CLI is not installed.\n' >&2
        exit 1
    fi
    wt="$(dirname "$repo_root")/wt-${branch//\//-}"
    # FUTURE/OPTIONAL: omp → Devin CLI provider integration; not part of the active stack.
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$wt" "$branch"
    else
        git worktree add -b "$branch" "$wt"
    fi
    cp .agent-spec.md "$wt/.agent-spec.md"
    {
        cat "$agent_home/agent/AGENTS.md"
        if [[ -f ./.agent-profile.md ]]; then
            printf '\n\n## Project profile\n'
            cat ./.agent-profile.md
        fi
    } > "$wt/.agent-profile.md"
    cd "$wt" && exec omp --model "$model" @.agent-spec.md

