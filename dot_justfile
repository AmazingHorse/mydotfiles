# Global agent control plane tasks. Invoke with: just -g <recipe>

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

agent_home := env("AGENT_HOME", home_directory() / ".omp")

[no-cd]
default:
    just --justfile {{quote(justfile())}} --list

[no-cd]
seed lang="" archetype="":
    #!/usr/bin/env bash
    set -euo pipefail
    agent_home={{quote(agent_home)}}
    lang="${1:-}"
    archetype="${2:-}"
    seeds_dir="$agent_home/seeds"
    archetypes_dir="$agent_home/archetypes"
    list_seeds() {
        printf 'Available seeds:\n'
        for seed_file in "$seeds_dir"/*.md; do
            [[ -f "$seed_file" ]] || continue
            basename "$seed_file" .md
        done
    }
    if [[ -z "$lang" ]]; then
        list_seeds
        exit 0
    fi
    seed_file="$seeds_dir/$lang.md"
    if [[ ! -f "$seed_file" ]]; then
        printf 'Unknown seed: %s\n' "$lang" >&2
        list_seeds >&2
        exit 1
    fi
    if [[ -n "$archetype" ]]; then
        archetype_file="$archetypes_dir/$archetype.md"
        if [[ ! -f "$archetype_file" ]]; then
            printf 'Unknown archetype: %s\n' "$archetype" >&2
            printf 'Available archetypes:\n' >&2
            for a_file in "$archetypes_dir"/*.md; do
                [[ -f "$a_file" ]] || continue
                basename "$a_file" .md >&2
            done
            exit 1
        fi
    fi
    if [[ -e ./.agent-profile.md ]]; then
        printf 'Refusing to overwrite .agent-profile.md\n' >&2
        exit 1
    fi
    cp "$seed_file" ./.agent-profile.md
    if [[ -n "$archetype" ]]; then
        {
            printf '\n\n## Archetype\n'
            cat "$archetypes_dir/$archetype.md"
        } >> ./.agent-profile.md
        printf 'Created .agent-profile.md from seed %s and archetype %s\n' "$lang" "$archetype"
    else
        printf 'Created .agent-profile.md from seed %s\n' "$lang"
    fi

[no-cd]
