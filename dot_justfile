omp-wt branch *args:
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    if ! command -v omp >/dev/null 2>&1; then
        printf 'omp is not installed; install it with mise use -g npm:@oh-my-pi/pi-coding-agent\n' >&2
        exit 1
    fi
    wt_bin=""
    if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
        wt_bin="${HOME}/.local/share/mise/shims/wt"
    elif command -v wt >/dev/null 2>&1; then
        cand="$(command -v wt)"
        case "${cand}" in
            /mnt/c/*|[A-Za-z]:/*) ;;
            *)
                if "${cand}" --version 2>/dev/null | grep -qE '^wt |worktrunk'; then
                    wt_bin="${cand}"
                fi
                ;;
        esac
    fi
    if [ -n "${wt_bin}" ]; then
        "$wt_bin" switch --create "$branch" -x omp -- "$@"
    else
        dir=$(just -g worktree-new "$branch")
        (cd "$dir" && omp "$@")
    fi

