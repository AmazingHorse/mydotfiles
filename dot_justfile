# Global agent control plane tasks. Invoke with: just -g <recipe>

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

agent_home := env("AGENT_HOME", home_directory() / ".omp")

[no-cd]
default:
    just --justfile {{quote(justfile())}} --list

[no-cd]
seed lang="" archetype="":
    #!/usr/bin/env bash
    set -euo pipefail
    agent_home={{quote(agent_home)}}
    lang="${1:-}"
    archetype="${2:-}"
    seeds_dir="$agent_home/seeds"
    archetypes_dir="$agent_home/archetypes"
    list_seeds() {
        printf 'Available seeds:\n'
        for seed_file in "$seeds_dir"/*.md; do
            [[ -f "$seed_file" ]] || continue
            basename "$seed_file" .md
        done
    }
    if [[ -z "$lang" ]]; then
        list_seeds
        exit 0
    fi
    seed_file="$seeds_dir/$lang.md"
    if [[ ! -f "$seed_file" ]]; then
        printf 'Unknown seed: %s\n' "$lang" >&2
        list_seeds >&2
        exit 1
    fi
    if [[ -n "$archetype" ]]; then
        archetype_file="$archetypes_dir/$archetype.md"
        if [[ ! -f "$archetype_file" ]]; then
            printf 'Unknown archetype: %s\n' "$archetype" >&2
            printf 'Available archetypes:\n' >&2
            for a_file in "$archetypes_dir"/*.md; do
                [[ -f "$a_file" ]] || continue
                basename "$a_file" .md >&2
            done
            exit 1
        fi
    fi
    if [[ -e ./.agent-profile.md ]]; then
        printf 'Refusing to overwrite .agent-profile.md\n' >&2
        exit 1
    fi
    cp "$seed_file" ./.agent-profile.md
    if [[ -n "$archetype" ]]; then
        {
            printf '\n\n## Archetype\n'
            cat "$archetypes_dir/$archetype.md"
        } >> ./.agent-profile.md
        printf 'Created .agent-profile.md from seed %s and archetype %s\n' "$lang" "$archetype"
    else
        printf 'Created .agent-profile.md from seed %s\n' "$lang"
    fi

[no-cd]
agent-init archetype="":
    just --justfile {{quote(justfile())}} seed "" {{quote(archetype)}}
[no-cd]
git-guard:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'Error: not inside a git work tree.\n' >&2
        exit 1
    fi
    current_branch="$(git branch --show-current 2>/dev/null || true)"
    if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
        printf 'Error: on %s branch. Switch to a feature/task branch first.\n' "$current_branch" >&2
        exit 1
    fi
    if ! git check-ignore -q .agent-spec.md 2>/dev/null || ! git check-ignore -q .agent-profile.md 2>/dev/null; then
        printf 'Error: .agent-spec.md and .agent-profile.md must be ignored by git.\n' >&2
        exit 1
    fi
    dirty_count="$(git status --porcelain | grep -c . || true)"
    if [[ "$dirty_count" -gt 0 ]]; then
        printf 'Warning: %s uncommitted file(s) in work tree.\n' "$dirty_count" >&2
    fi

[no-cd]
omp-sandbox *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v bwrap >/dev/null 2>&1; then
        printf 'bwrap is missing; install bubblewrap to run omp in sandbox mode.\n' >&2
        exit 1
    fi
    mkdir -p "$HOME/.omp" "$HOME/.cache" "$HOME/.local/share/mise"
    exec bwrap --ro-bind / / \
        --bind "$PWD" "$PWD" \
        --bind "$HOME/.omp" "$HOME/.omp" \
        --bind "$HOME/.cache" "$HOME/.cache" \
        --bind "$HOME/.local/share/mise" "$HOME/.local/share/mise" \
        --dev /dev \
        --proc /proc \
        --tmpfs /tmp \
        --die-with-parent \
        omp "$@"


[no-cd]
verify:
    #!/usr/bin/env bash
    set -euo pipefail

    # 0. Enforce that .agent-spec.md and .agent-profile.md are never tracked in git
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if git ls-files --error-unmatch .agent-spec.md >/dev/null 2>&1; then
            printf 'Error: .agent-spec.md is tracked in git. Untrack it before verifying/merging.\n' >&2
            exit 1
        fi
        if git ls-files --error-unmatch .agent-profile.md >/dev/null 2>&1; then
            printf 'Error: .agent-profile.md is tracked in git. Untrack it before verifying/merging.\n' >&2
            exit 1
        fi
    fi

    # 1. Spec-defined verification: extract and run command from .agent-spec.md
    if [[ -f .agent-spec.md ]]; then
        spec_cmd="$(awk '
            /^## Verification/ { in_verif = 1; next }
            /^## / { in_verif = 0 }
            in_verif {
                if ($0 ~ /^```/) next
                if ($0 ~ /^[[:space:]]*#/) next
                if (NF) {
                    lines = (lines ? lines "\n" : "") $0
                }
            }
            END { print lines }
        ' .agent-spec.md || true)"
        if [[ -n "${spec_cmd}" ]]; then
            printf '==> Running verification from .agent-spec.md:\n%s\n' "${spec_cmd}"
            bash -euo pipefail -c "${spec_cmd}"
            exit 0
        fi
    fi

    # 2. Project justfile verification: check, test-fast, or test
    if [[ -f justfile || -f Justfile || -f .justfile ]]; then
        if just --summary 2>/dev/null | grep -qw "check"; then
            printf '==> Running project verification: just check\n'
            exec just check
        elif just --summary 2>/dev/null | grep -qw "test-fast"; then
            printf '==> Running project verification: just test-fast\n'
            exec just test-fast
        elif just --summary 2>/dev/null | grep -qw "test"; then
            printf '==> Running project verification: just test\n'
            exec just test
        fi
    fi

    # 3. Auto-detect by lockfile / manifest
    if [[ -f bun.lock || -f bun.lockb ]]; then
        printf '==> Running bun verification: bun test\n'
        exec bun test
    elif [[ -f uv.lock || -f pyproject.toml ]]; then
        printf '==> Running uv/pytest verification: uv run pytest\n'
        exec uv run pytest
    elif [[ -f Cargo.toml ]]; then
        printf '==> Running cargo verification: cargo check && cargo test\n'
        cargo check && exec cargo test
    elif [[ -f package-lock.json ]]; then
        printf '==> Running npm verification: npm test\n'
        exec npm test
    elif [[ -f pnpm-lock.yaml ]]; then
        printf '==> Running pnpm verification: pnpm test\n'
        exec pnpm test
    fi

    printf '==> No verification target detected; passing verification gate.\n'

[no-cd]
worktree-new branch base="":
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    base={{quote(base)}}
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run worktree-new inside a git repository.\n' >&2
        exit 1
    fi
    wt_bin=""
    if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
        wt_bin="${HOME}/.local/share/mise/shims/wt"
    elif command -v wt >/dev/null 2>&1; then
        cand="$(command -v wt)"
        case "${cand}" in
            /mnt/c/*|[A-Za-z]:/*) ;;
            *)
                if "${cand}" --version 2>/dev/null | grep -qE '^wt |worktrunk'; then
                    wt_bin="${cand}"
                fi
                ;;
        esac
    fi
    if [ -n "${wt_bin}" ]; then
        if [ -n "$base" ]; then
            "$wt_bin" switch --create "$branch" --base "$base" --no-cd
        else
            "$wt_bin" switch --create "$branch" --no-cd
        fi
        exit 0
    fi
    safe_branch="${branch//\//-}"
    worktree_dir="$(dirname "$repo_root")/wt-$safe_branch"
    if [[ -d "$worktree_dir" ]]; then
        printf 'Worktree directory already exists: %s\n' "$worktree_dir" >&2
        exit 1
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$worktree_dir" "$branch"
    else
        start_point="${base:-HEAD}"
        git worktree add -b "$branch" "$worktree_dir" "$start_point"
    fi
    for file in .agent-spec.md .agent-profile.md .claude/settings.local.json .devin/config.local.json .omp/permissions.local.json; do
        if [[ -f "./$file" ]]; then
            mkdir -p "$(dirname "$worktree_dir/$file")"
            cp "./$file" "$worktree_dir/$file"
        fi
    done
    printf '%s\n' "$worktree_dir"

[no-cd]
worktree-merge branch="":
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    wt_bin=""
    if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
        wt_bin="${HOME}/.local/share/mise/shims/wt"
    elif command -v wt >/dev/null 2>&1; then
        cand="$(command -v wt)"
        case "${cand}" in
            /mnt/c/*|[A-Za-z]:/*) ;;
            *)
                if "${cand}" --version 2>/dev/null | grep -qE '^wt |worktrunk'; then
                    wt_bin="${cand}"
                fi
                ;;
        esac
    fi
    # Run pre-merge verification
    just --justfile {{quote(justfile())}} verify

    if [ -n "${wt_bin}" ]; then
        if [ -n "$branch" ]; then
            "$wt_bin" merge "$branch" --yes
        else
            "$wt_bin" merge --yes
        fi
    else
        printf 'Worktrunk (wt) is required for worktree-merge.\n' >&2
        exit 1
    fi

    # Post-merge cleanup
    common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git rev-parse --git-common-dir 2>/dev/null || true)"
    if [ -n "${common_dir}" ] && [ -n "${branch}" ]; then
        safe_branch="${branch//\//_}"
        rm -f "${common_dir}/agent-bus/${safe_branch}.md" "${common_dir}/agent-bus/${branch}.md" 2>/dev/null || true
    fi
    git worktree prune 2>/dev/null || true
[no-cd]
worktree-done branch:
    #!/usr/bin/env bash
    set -euo pipefail
    branch={{quote(branch)}}
    wt_bin=""
    if [ -x "${HOME}/.local/share/mise/shims/wt" ]; then
        wt_bin="${HOME}/.local/share/mise/shims/wt"
    elif command -v wt >/dev/null 2>&1; then
        cand="$(command -v wt)"
        case "${cand}" in
            /mnt/c/*|[A-Za-z]:/*) ;;
            *)
                if "${cand}" --version 2>/dev/null | grep -qE '^wt |worktrunk'; then
                    wt_bin="${cand}"
                fi
                ;;
        esac
    fi
    if [ -n "${wt_bin}" ]; then
        "$wt_bin" remove "$branch"
        exit 0
    fi
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run worktree-done inside a git repository.\n' >&2
        exit 1
    fi
    safe_branch="${branch//\//-}"
    worktree_dir="$(dirname "$repo_root")/wt-$safe_branch"
    if [[ ! -d "$worktree_dir" ]]; then
        printf 'Worktree directory does not exist: %s\n' "$worktree_dir" >&2
        exit 1
    fi
    if ! git worktree remove "$worktree_dir"; then
        printf 'Failed to remove worktree %s. If there are uncommitted changes, commit/stash them or remove manually.\n' "$worktree_dir" >&2
        exit 1
    fi

[no-cd]
worktree-rm branch:
    just -g worktree-done {{quote(branch)}}

