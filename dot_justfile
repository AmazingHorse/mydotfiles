worktree-gc:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        printf 'Run worktree-gc inside a git repository.\n' >&2
        exit 1
    fi

    printf '==> Pruning stale git worktree metadata...\n'
    git worktree prune -v

    common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || git rev-parse --git-common-dir 2>/dev/null || true)"
    base_branch="$(git rev-parse --abbrev-ref origin/HEAD 2>/dev/null | sed 's|^origin/||')"
    [ -n "$base_branch" ] || base_branch="main"

    printf '==> Checking for merged linked worktrees against %s...\n' "$base_branch"
    git worktree list --porcelain | awk '
        BEGIN { wt=""; br="" }
        /^worktree / { wt=$2 }
        /^branch / { br=$2; if (wt && br) { print wt, br }; wt=""; br="" }
    ' | while read -r wt_path wt_ref; do
        [ "$wt_path" != "$repo_root" ] || continue
        br_name="${wt_ref#refs/heads/}"

        if git merge-base --is-ancestor "$wt_ref" "$base_branch" 2>/dev/null; then
            if (cd "$wt_path" && git status --porcelain 2>/dev/null | grep -q .); then
                printf 'Notice: %s (%s) is merged but has uncommitted modifications; keeping.\n' "$wt_path" "$br_name"
            else
                printf 'Removing merged worktree: %s (%s)\n' "$wt_path" "$br_name"
                git worktree remove "$wt_path" 2>/dev/null || git worktree remove --force "$wt_path" 2>/dev/null || true
                git branch -d "$br_name" 2>/dev/null || true
                if [ -n "$common_dir" ]; then
                    safe_br="${br_name//\//_}"
                    rm -f "$common_dir/agent-bus/$safe_br.md" "$common_dir/agent-bus/$br_name.md" 2>/dev/null || true
                fi
            fi
        fi
    done

    # Clean orphaned agent-bus notes
    if [ -n "$common_dir" ] && [ -d "$common_dir/agent-bus" ]; then
        printf '==> Cleaning orphaned agent-bus handoff notes...\n'
        for note in "$common_dir/agent-bus/"*.md; do
            [ -f "$note" ] || continue
            note_name="$(basename "$note" .md)"
            if ! git show-ref --verify --quiet "refs/heads/$note_name" 2>/dev/null && \
               ! git show-ref --verify --quiet "refs/heads/${note_name//_//}" 2>/dev/null; then
                printf 'Removing orphaned bus note: %s\n' "$note"
                rm -f "$note"
            fi
        done
    fi
[no-cd]
doctor:
    #!/usr/bin/env bash
    set -euo pipefail
    agent_home={{quote(agent_home)}}
    report_value() {
        printf '%-18s %s\n' "$1" "$2"
    }
    report_value AGENT_ENV "${AGENT_ENV:-"(unset — source ~/.config/agent-env.sh)"}"
    report_value kernel "$(uname -srm)"
    report_value BROWSER "${BROWSER:-"(unset)"}"
    report_value OLLAMA_HOST "${OLLAMA_HOST:-"(unset)"}"
    report_value AGENT_HOME "${AGENT_HOME:-$agent_home}"
    printf '\nactive stack:\n'
    for binary in omp agy just rg bun node wt; do
        if binary_path="$(command -v "$binary" 2>/dev/null)"; then
            report_value "$binary" "$binary_path"
        else
            report_value "$binary" missing
        fi
    done
    printf '\nfuture (optional):\n'
    if binary_path="$(command -v devin 2>/dev/null)"; then
        report_value devin "$binary_path"
    else
        report_value devin missing
    fi
    printf '\nskills:\n'
    skills_dir="$agent_home/agent/skills"
    if [[ ! -d "$skills_dir" ]]; then
        report_value skills 'not linked (run: agy-crew install --hosts omp)'
    else
        skill_count=0
        for skill in "$skills_dir"/*; do
            [[ -e "$skill" || -L "$skill" ]] || continue
            skill_count=$((skill_count + 1))
        done
        report_value skills "$skill_count entries"
    fi
    printf '\nagent configuration:\n'
    config_file="$agent_home/agent/config.yml"
    if [[ -f "$config_file" ]] && grep -q 'approvalMode: write' "$config_file"; then
        report_value "approvalMode" "write (configured)"
    else
        report_value "approvalMode" "missing or not write"
    fi
    command_guard="$agent_home/agent/extensions/command-guard/index.ts"
    if [[ -f "$command_guard" ]]; then
        report_value "command-guard" "present"
    else
        report_value "command-guard" "missing"
    fi
    seeds_dir="$agent_home/seeds"
    if [[ ! -d "$seeds_dir" ]]; then
        report_value "seeds" "missing"
    else
        seed_count=0
        for seed_file in "$seeds_dir"/*.md; do
            [[ -f "$seed_file" ]] || continue
            seed_count=$((seed_count + 1))
        done
        report_value "seeds" "$seed_count found"
    fi
    printf '\nworktrunk & cross-harness hooks:\n'
    if command -v wt >/dev/null 2>&1; then
        report_value "worktrunk" "$(wt --version 2>/dev/null || echo "present")"
        if [[ -f "$agent_home/agent/hooks/pre/worktrunk.ts" ]]; then
            report_value "wt plugin (omp)" "installed"
        else
            report_value "wt plugin (omp)" "missing"
        fi
        claude_settings="$HOME/.claude/settings.json"
        if [[ -f "$claude_settings" ]] && grep -q 'hook.ts' "$claude_settings" 2>/dev/null; then
            report_value "command-guard hook" "registered (Claude Code)"
        else
            report_value "command-guard hook" "unregistered (Claude Code)"
        fi
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            wt_count="$(git worktree list --porcelain | grep -c '^worktree ' || true)"
            report_value "active worktrees" "$wt_count"
        fi
    else
        report_value "worktrunk" "missing"
    fi
    printf '\nchezmoi & agent rules:\n'
    if command -v chezmoi >/dev/null 2>&1; then
        chez_status="$(chezmoi status 2>/dev/null || true)"
        if [[ -z "$chez_status" ]]; then
            report_value "chezmoi status" "clean (in sync)"
        else
            report_value "chezmoi status" "changes pending"
        fi
        if chezmoi execute-template '{{ "{{" }} includeTemplate "agent-core.md" . {{ "}}" }}' >/dev/null 2>&1; then
            report_value "agent-core" "valid"
        else
            report_value "agent-core" "render error"
        fi
    fi
    printf '\npin drift:\n'
    if command -v chezmoi >/dev/null 2>&1; then
        data_file="$(chezmoi source-path 2>/dev/null || true)/.chezmoidata.toml"
        if [[ -f "$data_file" ]]; then
            read_pin() {
                awk -F'"' -v p="$1" '$0 ~ ("^[[:space:]]*" p "[[:space:]]*=") { print $2; exit }' "$data_file"
            }
            check_drift() {
                local tool="$1"
                local pin="$2"
                local ver
                if ! command -v "$tool" >/dev/null 2>&1; then
                    report_value "$tool" "missing (pin: $pin)"
                    return
                fi
                ver="$($tool --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 || true)"
                if [[ -z "$ver" ]]; then
                    report_value "$tool" "unknown version"
                elif [[ "$ver" == "$pin"* ]]; then
                    report_value "$tool" "$ver (in sync: $pin)"
                else
                    report_value "$tool" "$ver (DRIFT: pin $pin)"
                fi
            }
            check_drift "mise" "$(read_pin mise)"
            check_drift "just" "$(read_pin just)"
            check_drift "rg" "$(read_pin ripgrep)"
            check_drift "fd" "$(read_pin fd)"
            check_drift "zoxide" "$(read_pin zoxide)"
        fi
    fi
    printf '\n--- Secrets ---\n'
    for tool in fnox rbw rbw-agent uv yq; do
        if command -v "$tool" >/dev/null 2>&1; then
            report_value "$tool" "$($tool --version 2>/dev/null | head -n 1)"
        else
            report_value "$tool" "not installed"
        fi
    done
    if command -v rbw >/dev/null 2>&1; then
        if rbw unlocked >/dev/null 2>&1; then
            report_value "rbw vault" "unlocked"
        else
            report_value "rbw vault" "locked"
        fi
    fi
    if [[ -f fnox.toml ]] && command -v fnox >/dev/null 2>&1; then
        fnox doctor
    fi

