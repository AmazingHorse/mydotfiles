{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

ssh_directory="${HOME}/.ssh"
ssh_config_path="${ssh_directory}/config"
private_config_directory="${ssh_directory}/config.d"
private_config_path="${private_config_directory}/private.conf"

config_includes_config_d() {
    local path="$1"
    # CRLF-safe. Matches Include config.d/... or any path ending in config.d/...
    tr -d '\r' < "${path}" | grep -Eq '^[[:space:]]*Include[[:space:]].*config\.d(/|\\|[[:space:]]|$)'
}

strip_config_d_includes() {
    local source_path="$1"
    local destination_path="$2"
    tr -d '\r' < "${source_path}" |
        grep -Ev '^[[:space:]]*Include[[:space:]].*config\.d(/|\\|[[:space:]]|$)' >
        "${destination_path}"
}

write_private_stub() {
    cat > "${private_config_path}" <<'EOF'
# Machine-local SSH hosts only.
# Do not add "Include config.d/..." here — ~/.ssh/config already includes this directory.
EOF
    chmod 600 "${private_config_path}"
}

if [ ! -f "${ssh_config_path}" ]; then
    exit 0
fi

if config_includes_config_d "${ssh_config_path}"; then
    # Already on the managed layout. Never copy that Include into private.conf.
    if [ -f "${private_config_path}" ] && config_includes_config_d "${private_config_path}"; then
        repair_path="${private_config_path}.recurse-bak.$(date +%Y%m%d%H%M%S)"
        cp -p "${private_config_path}" "${repair_path}"
        write_private_stub
        echo "Removed recursive Include from ${private_config_path}" >&2
        echo "Previous broken file saved as ${repair_path}" >&2
        echo "Restore hosts from Windows ~/.ssh/config.d/private.conf or *.pre-chezmoi.bak*" >&2
    fi
    exit 0
fi

mkdir -p "${private_config_directory}"
chmod 700 "${ssh_directory}" "${private_config_directory}"

backup_path="${ssh_config_path}.pre-chezmoi.bak"
if [ -e "${backup_path}" ]; then
    backup_path="${backup_path}.$(date +%Y%m%d%H%M%S)"
fi
cp -p "${ssh_config_path}" "${backup_path}"
chmod 600 "${backup_path}"

if [ -s "${private_config_path}" ]; then
    if config_includes_config_d "${private_config_path}"; then
        repair_path="${private_config_path}.recurse-bak.$(date +%Y%m%d%H%M%S)"
        cp -p "${private_config_path}" "${repair_path}"
        strip_config_d_includes "${backup_path}" "${private_config_path}"
        if config_includes_config_d "${private_config_path}" || [ ! -s "${private_config_path}" ]; then
            write_private_stub
        else
            chmod 600 "${private_config_path}"
        fi
        echo "Repaired recursive Include in ${private_config_path}; previous saved as ${repair_path}" >&2
        exit 0
    fi
    echo "Existing ${private_config_path} preserved; merge ${backup_path} manually." >&2
    exit 0
fi

strip_config_d_includes "${ssh_config_path}" "${private_config_path}"
chmod 600 "${private_config_path}"
echo "Migrated existing SSH config to ${private_config_path}"
echo "Backup saved to ${backup_path}"
{{ end -}}
